% Keep the first enumeration table in these two sections within the text block.
\newcommand*{\olpCompactFirstArray}[1]{%
  \AddToHookNext{env/array/begin}{\renewcommand*{\arraystretch}{#1}}}
\newsavebox{\olpEnumerationBox}
\newcommand*{\olpLiftFirstEnumeration}{%
  \AddToHookNext{env/array/before}{\setbox\olpEnumerationBox=\hbox\bgroup$\displaystyle}%
  \AddToHookNext{env/array/after}{$\egroup
    \raisebox{6pt}[\height][\depth]{\usebox{\olpEnumerationBox}}}}
\AddToHook{cmd/olfileid/after}{%
  \ifdefstring{\theolpart}{sfr}{%
    \ifdefstring{\theolchapter}{siz}{%
      \ifdefstring{\theolsection}{zigzag}{\olpCompactFirstArray{0.88}}{}%
      \ifdefstring{\theolsection}{pai-alt}{\olpCompactFirstArray{0.72}\olpLiftFirstEnumeration}{}%
    }{}%
  }{}}
